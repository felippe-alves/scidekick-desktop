{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scidekick Desktop",
  "version": "0.1.0",
  "identifier": "io.scidekick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Scidekick Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop harness for Scidekick and agent-compatible coding tools.",
    "longDescription": "An agent-agnostic desktop harness for macOS and Linux, with Scidekick as the first-class default agent.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-2"]
      }
    }
  }
}
